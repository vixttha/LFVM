  "missing_values": {
    "optional": "Null/blank means unknown unless an explicit value_state exists. false and zero are known. For conflicting or not_applicable optional scalars, use one field_state relationship with field_name and value_state; the canonical field remains null.",
    "required": "Never blank; enum unknown only where defined; absence is a validation error."
  },
  "rules": {
    "identifier": "UUID v4 lowercase with hyphens; globally unique across research primary keys; foreign keys reference exact IDs; taxonomy and dictionary keys are namespaced text. Claim IDs may repeat only for the same target and field; they are not evidence row IDs.",
    "legacy_categories": "Preserve the nine exact original registry labels in legacy_category. The wider existing foundation taxonomy remains a separate classification family; no destructive rename.",
    "canonical": "Providers own hierarchy; offers own funding/access/billing; resources own configuration and quota; compatibility owns workload execution; assessments own risk; evidence owns provenance; history is append-only. No writable duplicate summaries.",
    "discovery": "Filter 05_OFFERS first, join service hierarchy and profile-level resources without combining different configurations. Derived CSV/JSON summaries may be regenerated; never treated as canonical.",
    "claims": "Material known claims require matching supporting field-level evidence. Conflicting claims remain separate. E0 is unverified; E3 official docs; E4 provisioning; E5 execution; E6 execution plus billing. No tier is a security guarantee. Field-state relationship rows attach conflicting/not_applicable to a null optional scalar; never overwrite a known value.",
    "freshness": "Claim-specific review_due; billing/access/availability 30 days, resource quotas 90 days, identity 365 days by default; earlier provider expiry wins. Stale is not verified current.",
    "zero_cost": "True requires documented exact eligibility/configuration and E6 evidence, no mandatory positive/unknown fee, no automatic paid conversion, exact bounded spend scenario; unknown is not free. No advertised $0 claim alone qualifies.",
    "partitions": "One workbook starts library; manifest registers table, paths and row counts; maximum 1,048,575 data rows per sheet, earlier rollover at 100000 rows or 50 MiB (whichever first), configurable only via schema revision. IDs and foreign keys validated globally across all partitions. Master manifest digest is in external release inventory to avoid self hash. No external workbook formulas. Partition count is per registered table; artifact_sha256 is null inside a manifest when it would hash itself, otherwise required for external partition inventory. Workbook release inventory is authoritative. Initial single-workbook manifest contains exactly one row per table, including itself, with counts measured from actual sheets. All local workbook digests remain null; the external inventory owns the digest. Multi-workbook draft validation uses an independently pinned external index, full local control tables, global counts and cross-workbook foreign keys. Limit 128 physical files and 1,000,000 research rows per verification batch, 50 MiB per workbook; streaming successor needed beyond this budget. Local manifest rows describe only their own physical workbook.",
    "storage": "XLSX values are literal typed cells; UTC dates YYYY-MM-DD, finite numbers, boolean true/false, numeric units explicit; no macros, connections, credentials or executable research. Currency is uppercase three-letter code syntax, with ISO 4217 membership to be verified during qualification. Canonical JSON claim values are scalars or structured literals. Numeric cell magnitude is limited to 10^15 and strings to 32767 UTF-16 code units for portable Excel storage. IDs and high-precision opaque values are text.",
    "versions": "Schema and data revisions independent; migration requires accepted source and target schema, lossless mappings, staged dry run, reconciliation and rollback. Draft schema never accepted by itself.",
    "validation": "Blank schema metadata allowed; all 8 research sheets empty in actual blank. Test synthetic rows only, no real records in this branch."
  },
